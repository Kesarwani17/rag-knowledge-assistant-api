# =============================================================================
# RAG Knowledge Assistant API - Environment Configuration
# =============================================================================
# Copy to fastapi-rag/.env and fill in your values

# -----------------------------------------------------------------------------
# Required: External Services
# -----------------------------------------------------------------------------
GROQ_API_KEY=gsk_your-groq-key-here          # Groq LLM API key (get from console.groq.com)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/ragdb  # PostgreSQL + pgvector
REDIS_URL=redis://localhost:6379/0           # Redis for semantic cache

# -----------------------------------------------------------------------------
# Optional: LLM / Generation
# -----------------------------------------------------------------------------
# GROQ_MODEL=openai/gpt-oss-120b             # Override default model (in llm.py)

# -----------------------------------------------------------------------------
# Optional: Multi-Tenancy / Auth
# -----------------------------------------------------------------------------
USE_MOCK_TENANT=false                        # true = demo single-tenant mode (no auth)
MOCK_TENANT_ID=acme_corp                     # Tenant ID when USE_MOCK_TENANT=true

# -----------------------------------------------------------------------------
# Optional: JEV Guardrail (External Answerability Check)
# -----------------------------------------------------------------------------
USE_JEV=false                                # Enable TypeSafe JEV guardrail
JEV_API_KEY=                                 # JEV API key (if USE_JEV=true)
JEV_API_URL=https://api.typesafe.ai/v1/decide
JEV_CONFIDENCE_THRESHOLD=0.9                 # Min confidence to refuse (0.0-1.0)

# -----------------------------------------------------------------------------
# Optional: Retrieval & Reranking Tuning
# -----------------------------------------------------------------------------
SIMILARITY_THRESHOLD=0.35                    # Min cosine similarity for vector results (0.0-1.0)
RERANK_TOP_K=3                               # How many chunks after CrossEncoder rerank
RETRIEVE_LIMIT=15                            # Initial candidates retrieved before rerank

# -----------------------------------------------------------------------------
# Optional: Database Connection Pool
# -----------------------------------------------------------------------------
DB_POOL_SIZE=10                              # SQLAlchemy pool size
DB_MAX_OVERFLOW=20                           # Extra connections above pool_size
DB_POOL_TIMEOUT=30                           # Seconds to wait for connection

# -----------------------------------------------------------------------------
# Optional: API Protection
# -----------------------------------------------------------------------------
MAX_REQUEST_SIZE=1048576                     # Max request body in bytes (1MB default)

# -----------------------------------------------------------------------------
# Optional: Logging
# -----------------------------------------------------------------------------
# LOG_LEVEL=INFO                             # structlog level: DEBUG, INFO, WARNING, ERROR